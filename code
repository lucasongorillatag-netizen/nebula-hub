local espEnabled = false
local namesEnabled = false
local outlinesEnabled = true

local espColor = Color3.fromRGB(170, 0, 255)
local outlineColor = Color3.fromRGB(0,0,0)

local highlights = {}

local function createESP(plr)
	if plr == player then return end
	if not plr.Character then return end

	local char = plr.Character

	if highlights[plr] then
		highlights[plr]:Destroy()
	end

	local highlight = Instance.new("Highlight")
	highlight.FillColor = espColor
	highlight.OutlineColor = outlineColor
	highlight.FillTransparency = 0.35
	highlight.OutlineTransparency = outlinesEnabled and 0 or 1
	highlight.Adornee = char
	highlight.Parent = game.CoreGui

	highlights[plr] = highlight

	if namesEnabled then
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "NebulaNameESP"
		billboard.Size = UDim2.new(0,200,0,50)
		billboard.AlwaysOnTop = true
		billboard.StudsOffset = Vector3.new(0,3,0)
		billboard.Parent = char:FindFirstChild("Head")

		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1,0,1,0)
		label.BackgroundTransparency = 1
		label.Text = plr.Name
		label.TextColor3 = espColor
		label.TextStrokeTransparency = outlinesEnabled and 0 or 1
		label.Font = Enum.Font.Montserrat
		label.TextScaled = true
		label.Parent = billboard
	end
end

local function refreshESP()
	for _,v in pairs(highlights) do
		v:Destroy()
	end

	highlights = {}

	for _,plr in pairs(Players:GetPlayers()) do
		if espEnabled then
			createESP(plr)
		end
	end
end

Players.PlayerAdded:Connect(function(plr)
	plr.CharacterAdded:Connect(function()
		task.wait(1)
		refreshESP()
	end)
end)

